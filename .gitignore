# ---- Server/Bin is tracked on purpose (build output + game data), added 22 Oct 2026 ----
# `**/bin` above hides every bin folder; these later rules bring Server/Bin back.
!Server/Bin/
!Server/Bin/**
# ...except things that must not be published:
# Config holds settings.json (Discord token, JWT keys, DB passwords) and the dev TLS certificate/private key.
Server/Bin/Config/
# runtime logs
Server/Bin/**/logs/
Server/Bin/**/*.log

# Tools/ExtractImages build output
Tools/ExtractImages/out/
*.pdb
# ClientLauncher build output
Tools/ClientLauncher/out/
