{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.AspNetCore.Mvc": "Debug",
      "Microsoft.AspNetCore.Authentication": "Debug",
      "M5": "Debug"
    },
    "Console": {
      "IncludeScopes": true,
