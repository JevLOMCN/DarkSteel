<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Theme merged relative to this file for the XAML designer; the runtime
         loader sets ParserContext.BaseUri so the relative Source resolves. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">

            <!-- Mir 5 client launcher. Logic: ClientPanel.cpp -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="CLIENT" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock Text="Client folder (contains ProjectDS\Binaries\Win64\ProjectDS.exe)" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ClientPathBox" Grid.Column="0" Margin="0,0,8,0"
                                 ToolTip="The client Windows folder (where Mir5_Local.bat lives). Saved relative to this tool when it is on the same drive."/>
                        <Button x:Name="BrowseClientButton" Grid.Column="1" Content="Browse..."/>
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Game server IP / host" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,4"/>
                            <TextBox x:Name="ClientHostBox" ToolTip="Sent as -GameServer=host:port (127.0.0.1 for a local server)"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Port" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,4"/>
                            <TextBox x:Name="ClientPortBox" ToolTip="The server's game port (31101)"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,8,0">
                            <TextBlock Text="Width" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,4"/>
                            <TextBox x:Name="ClientResXBox"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Height" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,4"/>
                            <TextBox x:Name="ClientResYBox"/>
                        </StackPanel>
                    </Grid>

                    <CheckBox x:Name="ClientWindowedCheck" Content="Windowed" Margin="0,10,0,0"/>

                    <TextBlock Text="Extra command-line arguments" Style="{StaticResource MutedTextStyle}" Margin="0,10,0,4"/>
                    <TextBox x:Name="ClientExtraArgsBox" ToolTip="Appended to the command, for example -AIPlay or -log"/>

                    <TextBlock Text="ENGINE.INI (the client's TLS settings)" Style="{StaticResource CardTitleStyle}" Margin="0,16,0,6"/>
                    <TextBlock Text="SSL certificate (.pem)" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ClientCertBox" Grid.Column="0" Margin="0,0,8,0"
                                 ToolTip="Written to Engine.ini [SSL] DebuggingCertificatePath. Empty = Server\Config\dev-cert.pem. Saved relative when possible; Engine.ini itself gets the absolute path."/>
                        <Button x:Name="BrowseCertButton" Grid.Column="1" Content="Browse..."/>
                    </Grid>
                    <CheckBox x:Name="ClientSkipVerifyCheck" Margin="0,10,0,0"
                              Content="Skip TLS verification  ([HTTP.Curl] bVerifyPeer=false)"/>
                    <CheckBox x:Name="ClientAutoIniCheck" Margin="0,6,0,0"
                              Content="Create or refresh Engine.ini every time the client is started from here"/>
                    <TextBlock x:Name="ClientIniStatusText" Style="{StaticResource MutedTextStyle}" FontSize="11.5"
                               TextWrapping="Wrap" Margin="0,8,0,0"/>

                    <TextBlock Text="COMMAND" Style="{StaticResource CardTitleStyle}" Margin="0,16,0,4"/>
                    <TextBlock x:Name="ClientCommandText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="ClientLaunchButton" Content="Launch client" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                        <Button x:Name="ClientWriteIniButton" Content="Write Engine.ini" Margin="0,0,8,0"
                                ToolTip="Create Engine.ini in the client's Saved\Config\Windows folder, or update just the two keys above"/>
                        <Button x:Name="ClientOpenLogsButton" Content="Open client logs" Margin="0,0,8,0"/>
                        <Button x:Name="ClientSaveButton" Content="Save"/>
                    </StackPanel>
                    <TextBlock x:Name="ClientSaveNoteText" Style="{StaticResource MutedTextStyle}" FontSize="11.5" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="Launching uses what is on screen. Save keeps the values for next time."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>