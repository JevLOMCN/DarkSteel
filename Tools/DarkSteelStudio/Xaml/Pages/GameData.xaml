<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Theme merged relative to this file for the XAML designer; the runtime
         loader sets ParserContext.BaseUri so the relative Source resolves. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- Game Data: Mir 5 items (Common\ItemBase.json + String\Eng\StringItem_Eng.json) with their icons.
         Logic: ItemBrowser.cpp. -->
    <DockPanel>
        <TextBlock x:Name="ItemFooterText" DockPanel.Dock="Bottom" Style="{StaticResource MutedTextStyle}"
                   Margin="0,8,0,0" TextWrapping="Wrap"/>

        <!-- Search / filter bar -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock x:Name="ItemCountText" DockPanel.Dock="Right" Style="{StaticResource MutedTextStyle}"
                       VerticalAlignment="Center" Margin="12,0,0,0"/>
            <Button x:Name="ItemReloadButton" DockPanel.Dock="Right" Content="Reload" Margin="8,0,0,0"
                    ToolTip="Read ItemBase.json and the English strings again"/>
            <ComboBox x:Name="ItemGradeBox" DockPanel.Dock="Right" Width="150" Margin="8,0,0,0"/>
            <ComboBox x:Name="ItemTypeBox" DockPanel.Dock="Right" Width="170" Margin="8,0,0,0"/>
            <TextBox x:Name="ItemSearchBox"
                     ToolTip="Item name, item id or item type (for example 'potion', '10510001' or 'ArmorChest')"/>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="460" MinWidth="340"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="ItemGrid" Grid.Column="0" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False"
                      EnableRowVirtualization="True" ClipboardCopyMode="IncludeHeader"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="44" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding IconPath}" Width="32" Height="32" Margin="2"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="100"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding MainType}" Width="90"/>
                    <DataGridTextColumn Header="Item type" Binding="{Binding ItemType}" Width="150"/>
                    <DataGridTextColumn Header="Grade" Binding="{Binding Grade}" Width="90"/>
                    <DataGridTextColumn Header="Lvl" Binding="{Binding Level}" Width="50"/>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Selected item -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0" Padding="12">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <Border DockPanel.Dock="Left" Width="96" Height="96" Margin="0,0,12,0"
                                Background="{StaticResource Brush.Window}"
                                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="4">
                            <Image x:Name="ItemDetailIcon" Stretch="Uniform" Margin="4"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel>
                            <TextBlock x:Name="ItemDetailTitle" Style="{StaticResource HeadingTextStyle}"
                                       Text="Select an item" TextWrapping="Wrap"/>
                            <TextBlock x:Name="ItemDetailMeta" Style="{StaticResource MutedTextStyle}"
                                       FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ItemCopyIdButton" Content="Copy ID" Margin="0,0,8,0" IsEnabled="False"/>
                                <Button x:Name="ItemCopyCommandButton" Content="Copy GM command" IsEnabled="False"
                                        ToolTip="Copies 'item &lt;id&gt; 1' for the in-game chat"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>

                    <TextBlock x:Name="ItemDetailText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,10,0,10"/>

                    <TextBlock Text="FIELDS" DockPanel.Dock="Top" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,4"/>
                    <DataGrid x:Name="ItemFieldGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column" ClipboardCopyMode="IncludeHeader">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Field" Binding="{Binding Field}" Width="150"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                            <DataGridTextColumn Header="Text" Binding="{Binding Text}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
