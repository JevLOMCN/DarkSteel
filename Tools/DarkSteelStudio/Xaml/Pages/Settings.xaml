<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Theme merged relative to this file for the XAML designer; the runtime
         loader sets ParserContext.BaseUri so the relative Source resolves. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">

            <!-- Servers -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="FOLDERS" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock Text="Server folder (contains Bin\Data)" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ServersPathBox" Grid.Column="0" Margin="0,0,8,0"
                                 ToolTip="The Mir 5 Server folder (the one with Bin\Data). Saved relative to this tool when it is on the same drive, so a checkout elsewhere still works. Empty = auto-detect."/>
                        <Button x:Name="BrowseServersButton" Grid.Column="1" Content="Browse..."/>
                    </Grid>
                    <TextBlock Text="Images folder (contains Items)" Style="{StaticResource MutedTextStyle}" Margin="0,10,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ImagesPathBox" Grid.Column="0" Margin="0,0,8,0"
                                 ToolTip="Folder with the extracted icons (Tools\Images; the item icons are in its Items folder). Saved relative when possible. Empty = auto-detect."/>
                        <Button x:Name="BrowseImagesButton" Grid.Column="1" Content="Browse..."/>
                    </Grid>
                    <TextBlock x:Name="FoldersNoteText" Style="{StaticResource MutedTextStyle}" FontSize="11.5" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Game database -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="GAME DATABASE" Style="{StaticResource CardTitleStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Host" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
                        <TextBox x:Name="DbHostBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Port" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
                        <TextBox x:Name="DbPortBox" Grid.Row="1" Grid.Column="1" Width="120" HorizontalAlignment="Left" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="User" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
                        <TextBox x:Name="DbUserBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Password" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
                        <PasswordBox x:Name="DbPassBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Game schema" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
                        <TextBox x:Name="GameSchemaBox" Grid.Row="4" Grid.Column="1"
                                 ToolTip="Mir 5 game data lives in ds_game"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Studio -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="STUDIO" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock Text="XAML root" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,4"/>
                    <TextBox x:Name="XamlRootBox"
                             ToolTip="Leave empty to use the Xaml folder next to the exe. Point it at Code\Tools\DarkSteelStudio\Xaml to edit the UI live."/>
                    <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"
                               Text="Leave empty to use the Xaml folder next to the exe."/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button x:Name="SaveSettingsButton" Content="Save settings"
                        Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                <Button x:Name="TestDbButton" Content="Test connection" Margin="0,0,12,0"
                        ToolTip="Connects with the values currently in the boxes above (no save needed)"/>
                <TextBlock x:Name="SettingsStatusText" Style="{StaticResource MutedTextStyle}"
                           VerticalAlignment="Center" Text=""/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
