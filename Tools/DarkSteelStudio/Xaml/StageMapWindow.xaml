<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DarkSteel Studio - Stage Map"
        Width="1100" Height="800" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}">

    <!-- Theme merged relative to this file (the loader sets ParserContext.BaseUri). -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>

        <!-- Header: title, subtitle, status, Back / Fit -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Brush.Sidebar}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="MapBackButton" Content="Back" Margin="0,0,8,0" IsEnabled="False"
                            ToolTip="Return to the previous map"/>
                    <Button x:Name="MapFitButton" Content="Fit" Margin="0,0,8,0" ToolTip="Fit the map to the window"/>
                    <Button x:Name="MapOpenGenButton" Content="Respawn JSON"
                            ToolTip="Open this stage's Gen\GENDATA_&lt;stage&gt;.json (the respawn list) in the default editor"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="MapTitleText" Style="{StaticResource HeadingTextStyle}" Text="Stage map"/>
                    <TextBlock x:Name="MapSubtitleText" Style="{StaticResource MutedTextStyle}"/>
                    <TextBlock x:Name="MapStatusText" Style="{StaticResource MutedTextStyle}" FontSize="11.5" Margin="0,2,0,0"
                               Text="Loading..."/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Left: marker type filters -->
        <Border DockPanel.Dock="Left" Width="210" Background="{StaticResource Brush.Sidebar}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0" Padding="14,12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="MARKERS" Style="{StaticResource CardTitleStyle}"/>
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource MutedTextStyle}" FontSize="11" TextWrapping="Wrap"
                           Text="Wheel to zoom, drag to pan. Click a marker for details; double-click a gold marker to open that map."/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PoiFilterPanel"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Right: info for the clicked marker (monster, object, NPC, map movement, ...) -->
        <Border x:Name="PoiInfoPanel" DockPanel.Dock="Right" Width="270" Visibility="Collapsed"
                Background="{StaticResource Brush.Sidebar}" BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1,0,0,0" Padding="14,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Image x:Name="PoiInfoImage" Width="112" Height="112" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                    <TextBlock x:Name="PoiInfoName" Style="{StaticResource HeadingTextStyle}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="PoiInfoMeta" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <TextBlock x:Name="PoiInfoCoords" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    <TextBlock x:Name="PoiInfoExtra" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <Button x:Name="PoiCopyButton" Content="Copy Command" Margin="0,14,0,0" HorizontalAlignment="Stretch"
                            Style="{StaticResource PrimaryButtonStyle}" Visibility="Collapsed"/>
                    <Button x:Name="PoiOpenMapButton" Content="Move" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                            ToolTip="Open the destination map in this window"
                            Visibility="Collapsed"/>

                    <!-- Map links: the warps that lead back from the destination into THIS map -->
                    <TextBlock x:Name="PoiReturnTitle" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Brush.Gold}"
                               TextWrapping="Wrap" Margin="0,16,0,4" Visibility="Collapsed"/>
                    <ItemsControl x:Name="PoiReturnList" Visibility="Collapsed">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource Brush.Border}" Padding="0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}"/>
                                            <TextBlock Text="{Binding ArrivalText}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource Brush.TextMuted}" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding FromText}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource Brush.TextMuted}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <!-- one click handler on the list (OnReturnCopyClick); the command rides in Tag -->
                                        <Button Grid.Column="1" Content="Copy" Tag="{Binding Command}" ToolTip="{Binding Command}" VerticalAlignment="Top" Margin="8,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Map viewport: zoom and pan happen in code on MapSurface -->
        <Border x:Name="MapViewport" Background="#FF121316" ClipToBounds="True">
            <Grid x:Name="MapSurface" HorizontalAlignment="Left" VerticalAlignment="Top" Width="1000" Height="1000"
                  RenderTransformOrigin="0,0">
                <Rectangle x:Name="MapBlank" Fill="#FF1A1B20" Visibility="Collapsed"/>
                <Image x:Name="MapImage" Stretch="Fill"/>
                <Canvas x:Name="MarkerCanvas" ClipToBounds="False"/>
            </Grid>
        </Border>

    </DockPanel>
</Window>
