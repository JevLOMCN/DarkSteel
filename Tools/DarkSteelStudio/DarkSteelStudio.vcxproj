    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <AdditionalLibraryDirectories>$(ProjectDir)external\mysql-connector-c\prebuilt\windows;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <EntryPointSymbol>main</EntryPointSymbol>
    </Link>
    <PostBuildEvent>
      <!--
        The XAML is NOT compiled into the exe (vcxproj has no BAML step) - it is
        loaded from a "Xaml" folder next to the executable at runtime, so it
        must travel with the build output. Edit the .xaml files, rebuild (or
        just re-run this copy) and press F5 in the app to reload the UI.
      -->
      <Command>copy /Y "$(ProjectDir)DarkSteelStudio.config.json" "$(TargetDir)DarkSteelStudio.config.json"
if exist "$(ProjectDir)external\mysql-connector-c\prebuilt\windows\libmysql.dll" copy /Y "$(ProjectDir)external\mysql-connector-c\prebuilt\windows\libmysql.dll" "$(TargetDir)libmysql.dll"
xcopy /Y /I /E "$(ProjectDir)Xaml\*" "$(TargetDir)Xaml\"</Command>
      <Message>Running '$(TargetName)' post-build-event ...</Message>
    </PostBuildEvent>
  </ItemDefinitionGroup>
