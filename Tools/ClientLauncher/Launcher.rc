// Resources of the launcher. The two RCDATA strings are what the original BootstrapPackagedGame stub carried:
//   201: path of the real game exe relative to the launcher
//   202: game name (first argument given to the game)
//   203: default arguments added to every start (a "-Key=" already on the command line replaces its default); ClientLauncher.ini overrides it
// Change them here to launch a different packaged game. The strings are UTF-16.
#include <winres.h>

201 RCDATA { L"ProjectDS\\Binaries\\Win64\\ProjectDS.exe\0" }
202 RCDATA { L"ProjectDS\0" }
203 RCDATA { L"-GameServer=127.0.0.1:31101\0" }

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileVersion", "1.0.0.0"
            VALUE "ProductVersion", "1.0.0.0"
            VALUE "ProductName", "Mir 5 DarkSteel Launcher"
            VALUE "FileDescription", "Launcher for the Mir 5 (DarkSteel) client"
            VALUE "InternalName", "ClientLauncher"
            VALUE "OriginalFilename", "ProjectDS.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END